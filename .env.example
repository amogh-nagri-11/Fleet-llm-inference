# Gateway
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0
API_KEY=your_api_key_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Workers (comma-separated list of Ollama worker URLs)
WORKER_URLS=http://worker1:11434,http://worker2:11434

# Model
DEFAULT_MODEL=llama3.1:8b
MAX_TOKENS=2048
REQUEST_TIMEOUT=120

# Routing Strategy: round_robin | least_latency | queue_depth
ROUTING_STRATEGY=least_latency

# Context budgeting (not wired into the live request path yet — Phase 9)
CONTEXT_BUDGET_DEFAULT=8192
# Selection policy: full | recent | relevance | budget_aware | hybrid
CONTEXT_SELECTION_POLICY=hybrid

# Autoscaler
# Standby Ollama URLs the autoscaler registers into the load balancer at runtime
# when Docker container spin-up is unavailable (comma-separated, must be running).
STANDBY_WORKER_URLS=http://localhost:11435
AUTOSCALE_MIN_WORKERS=1
AUTOSCALE_MAX_WORKERS=4
AUTOSCALE_UP_THRESHOLD=3
AUTOSCALE_DOWN_THRESHOLD=0
AUTOSCALE_CHECK_INTERVAL=10
AUTOSCALE_COOLDOWN=30

# Circuit Breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
